{
  "name": "streamdeck-app",
  "productName": "Stream Deck ESP",
  "version": "1.1.0",
  "description": "Stream Deck de toque (ES32S3) - app de barra de menu com o servidor e a página de configuração",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "build:server": "node scripts/build-server.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dev": "npm run build:server && electron .",
    "dist": "npm run build:server && node scripts/dist.mjs",
    "pack": "node scripts/pack.mjs",
    "release": "npm run dist && npm run pack"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "bonjour-service": "^1.4.4",
    "omggif": "^1.0.10",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "serialport": "^13.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1"
  }
}
